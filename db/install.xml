<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/masterypractice/db" VERSION="20261006" COMMENT="XMLDB file for Mastery Practice"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="masterypractice" COMMENT="Mastery Practice activity configuration">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="scheduler" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="adaptive" SEQUENCE="false"/>
        <FIELD NAME="questionspersession" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="10" SEQUENCE="false"/>
        <FIELD NAME="minquestions" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="5" SEQUENCE="false"/>
        <FIELD NAME="maxquestions" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="20" SEQUENCE="false"/>
        <FIELD NAME="estimatedminutes" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="8" SEQUENCE="false"/>
        <FIELD NAME="mixconcepts" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="allowextra" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="minsessioninterval" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="mininterval" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="3600" SEQUENCE="false"/>
        <FIELD NAME="maxinterval" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="15552000" SEQUENCE="false"/>
        <FIELD NAME="maxdailyreviews" TYPE="int" LENGTH="6" NOTNULL="true" DEFAULT="50" SEQUENCE="false"/>
        <FIELD NAME="decayhalflifedays" TYPE="int" LENGTH="6" NOTNULL="true" DEFAULT="90" SEQUENCE="false"/>
        <FIELD NAME="gradepolicy" TYPE="char" LENGTH="32" NOTNULL="true" DEFAULT="none" SEQUENCE="false"/>
        <FIELD NAME="grade" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="100" SEQUENCE="false"/>
        <FIELD NAME="notifreview" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="notifcooldown" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="259200" SEQUENCE="false"/>
        <FIELD NAME="completionsessions" TYPE="int" LENGTH="6" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="completionquestions" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="completionmastery" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="completioncritical" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course_fk" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>

    <TABLE NAME="masterypractice_concepts" COMMENT="Selected question bank concepts">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="masterypracticeid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sourcetype" TYPE="char" LENGTH="16" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="sourceid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="includesubcategories" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="weight" TYPE="number" LENGTH="10" DECIMALS="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
        <FIELD NAME="critical" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="criticalthreshold" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="true" DEFAULT="60" SEQUENCE="false"/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="activity_fk" TYPE="foreign" FIELDS="masterypracticeid" REFTABLE="masterypractice" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="activity_source_uix" UNIQUE="true" FIELDS="masterypracticeid,sourcetype,sourceid"/>
        <INDEX NAME="activity_sort_ix" UNIQUE="false" FIELDS="masterypracticeid,sortorder"/>
      </INDEXES>
    </TABLE>

